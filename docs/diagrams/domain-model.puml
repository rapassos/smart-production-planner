@startuml

class Customer {
    UUID id
    String code
    String name
    String city
    String state
    String country
    Boolean active
}

class SalesOrder {
    UUID id
    String orderNumber
    LocalDate orderDate
    LocalDate dueDate
    OrderStatus status
}

class SalesOrderItem {
    UUID id
    Integer quantity
    BigDecimal unitPrice
}

class Product {
    UUID id
    String code
    String description
    String family
    Integer standardCycleTime
}

class Resource {
    UUID id
    String code
    String description
    ResourceType type
    Integer availableHoursPerDay
}

class ProductionOrder {
    UUID id
    String productionOrderNumber
    Integer quantity
    LocalDate startDate
    LocalDate endDate
    ProductionOrderStatus status
}

class CapacityPlan {
    UUID id
    String name
    LocalDate startDate
    LocalDate endDate
    String notes
}

Customer ||--o{ SalesOrder

SalesOrder ||--o{ SalesOrderItem

Product ||--o{ SalesOrderItem

Product ||--o{ ProductionOrder

Resource ||--o{ ProductionOrder

SalesOrder ||--o{ ProductionOrder

CapacityPlan ||--o{ ProductionOrder

@enduml
